FROM python:3.12-slim

RUN pip install --no-cache-dir uv

RUN useradd -m -s /bin/bash sandboxuser
WORKDIR /app

COPY pyproject.toml uv.lock ./

RUN uv export --no-hashes --frozen -o requirements.txt && uv pip install --system -r requirements.txt

# Only the engine: the sandbox runs participant code, so the web layer and
# its dependencies stay out, and a recursive chown on a large tree stalls
# on some storage drivers.
COPY --chown=sandboxuser:sandboxuser src/benchmark_core /app/src/benchmark_core

ENV PYTHONPATH=/app:/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER sandboxuser

ENTRYPOINT ["python", "src/benchmark_core/optimization_engine/optimizers/validation/verify_optimizer.py"]
