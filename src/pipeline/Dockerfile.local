# The image behind the local test executor. It runs the benchmark itself instead
# of submitting it, so it carries the engine and its numerical stack rather than
# an SSH client, and it is deliberately not the image any centre runs.
FROM python:3.12-slim

WORKDIR /app

# CPU wheels from PyTorch's own index: the default PyPI wheel pulls in roughly
# three gigabytes of CUDA libraries that nothing here can use.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch

RUN pip install --no-cache-dir \
        "pika>=1.4.4" "psycopg[binary]>=3.3.4" "numpy>=1.24" "scipy>=1.11" \
        "scikit-learn>=1.3" "matplotlib>=3.7" "cma>=3.3"

COPY src/shared/         /app/shared/
COPY src/pipeline/       /app/pipeline/
COPY src/benchmark_core/ /app/src/benchmark_core/
COPY tools/              /app/tools/

ENV PYTHONPATH=/app:/app/src \
    MPLCONFIGDIR=/tmp/matplotlib

ENTRYPOINT ["python", "-m", "pipeline.run"]
CMD ["worker"]
