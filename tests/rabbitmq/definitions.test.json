{
  "vhosts": [
    {"name": "/"}
  ],
  "users": [
    {"name": "USER", "password": "PASSWORD", "tags": "administrator"}
  ],
  "permissions": [
    {"user": "USER", "vhost": "/", "configure": ".*", "write": ".*", "read": ".*"}
  ],
  "exchanges": [
    {"name": "dlx_exchange", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false},
    {"name": "main_exchange", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false}
  ],
  "queues": [
    {"name": "dlq_fake_worker_queue", "vhost": "/", "durable": true},
    {"name": "dlq_fake_downloader_queue", "vhost": "/", "durable": true},
    {
      "name": "fake_worker_queue",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dlx_exchange",
        "x-dead-letter-routing-key": "failed_fake_worker_task"
      }
    },
    {
      "name": "fake_downloader_queue",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dlx_exchange",
        "x-dead-letter-routing-key": "failed_fake_downloader_task"
      }
    }
  ],
  "bindings": [
    {
      "source": "dlx_exchange",
      "vhost": "/",
      "destination": "dlq_fake_worker_queue",
      "destination_type": "queue",
      "routing_key": "failed_fake_worker_task"
    },
    {
      "source": "dlx_exchange",
      "vhost": "/",
      "destination": "dlq_fake_downloader_queue",
      "destination_type": "queue",
      "routing_key": "failed_fake_downloader_task"
    },
    {
      "source": "main_exchange",
      "vhost": "/",
      "destination": "fake_downloader_queue",
      "destination_type": "queue",
      "routing_key": "fake_downloader_queue"
    },
    {
      "source": "main_exchange",
      "vhost": "/",
      "destination": "fake_worker_queue",
      "destination_type": "queue",
      "routing_key": "fake_worker_queue"
    }
  ]
}