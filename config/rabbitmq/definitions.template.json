{
  "vhosts": [
    {"name": "/"}
  ],
  "users": [
    {"name": "[USER]", "password": "[PASSWORD]", "tags": "administrator"}
  ],
  "permissions": [
    {"user": "[USER]", "vhost": "/", "configure": ".*", "write": ".*", "read": ".*"}
  ],
  "exchanges": [
    {"name": "dlx_exchange", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false},
    {"name": "main_exchange", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false}
  ],
  "queues": [
    {"name": "dlq_[EXECUTOR]_worker_queue", "vhost": "/", "durable": true},
    {"name": "dlq_[EXECUTOR]_downloader_queue", "vhost": "/", "durable": true},
    {
      "name": "[EXECUTOR]_worker_queue",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dlx_exchange",
        "x-dead-letter-routing-key": "failed_[EXECUTOR]_worker_task"
      }
    },
    {
      "name": "[EXECUTOR]_downloader_queue",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "dlx_exchange",
        "x-dead-letter-routing-key": "failed_[EXECUTOR]_downloader_task"
      }
    }
  ],
  "bindings": [
    {
      "source": "dlx_exchange",
      "vhost": "/",
      "destination": "dlq_[EXECUTOR]_worker_queue",
      "destination_type": "queue",
      "routing_key": "failed_[EXECUTOR]_worker_task"
    },
    {
      "source": "dlx_exchange",
      "vhost": "/",
      "destination": "dlq_[EXECUTOR]_downloader_queue",
      "destination_type": "queue",
      "routing_key": "failed_[EXECUTOR]_downloader_task"
    },
    {
      "source": "main_exchange",
      "vhost": "/",
      "destination": "[EXECUTOR]_downloader_queue",
      "destination_type": "queue",
      "routing_key": "[EXECUTOR]_downloader_queue"
    },
    {
      "source": "main_exchange",
      "vhost": "/",
      "destination": "[EXECUTOR]_worker_queue",
      "destination_type": "queue",
      "routing_key": "[EXECUTOR]_worker_queue"
    }
  ]
}